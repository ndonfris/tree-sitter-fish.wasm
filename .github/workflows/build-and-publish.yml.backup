name: Build and Publish tree-sitter-fish WASM

on:
  schedule:
    # Check for new releases twice weekly (Monday and Thursday at 9 AM UTC)
    - cron: '0 9 * * 1,4'
  workflow_dispatch:
    # Allow manual trigger
  release:
    types: [prereleased]
    # Trigger on pre-releases pushed to this repo

jobs:
  check-and-build:
    runs-on: ubuntu-latest
    
    steps:
    - name: Checkout repo
      uses: actions/checkout@v4
      with:
        fetch-depth: 0

    - name: Setup Node.js
      uses: actions/setup-node@v4
      with:
        node-version: '20'
        registry-url: 'https://registry.npmjs.org'

    - name: Install Yarn
      run: npm install -g yarn@1.22.22

    - name: Install build dependencies
      run: |
        sudo apt-get update
        sudo apt-get install -y build-essential python3 python3-pip
        npm install -g node-gyp

    - name: Setup Emscripten
      uses: mymindstorm/setup-emsdk@v14
      with:
        version: '3.1.45'

    - name: Get latest upstream release
      id: upstream-release
      run: |
        LATEST_TAG=$(curl -s https://api.github.com/repos/ram02z/tree-sitter-fish/releases/latest | jq -r .tag_name)
        echo "latest_tag=$LATEST_TAG" >> $GITHUB_OUTPUT
        echo "Latest upstream tag: $LATEST_TAG"

    - name: Get existing releases from this repo
      id: existing-releases
      run: |
        # Get all releases from this repo (non-prerelease only for comparison)
        EXISTING_RELEASES=$(curl -s https://api.github.com/repos/${{ github.repository }}/releases | jq -r '.[] | select(.prerelease == false) | .tag_name' | head -10)
        echo "existing_releases<<EOF" >> $GITHUB_OUTPUT
        echo "$EXISTING_RELEASES" >> $GITHUB_OUTPUT
        echo "EOF" >> $GITHUB_OUTPUT
        echo "Existing releases in this repo:"
        echo "$EXISTING_RELEASES"

    - name: Check if new version available
      id: version-check
      run: |
        UPSTREAM_TAG="${{ steps.upstream-release.outputs.latest_tag }}"
        EXISTING_RELEASES="${{ steps.existing-releases.outputs.existing_releases }}"
        
        # Check if upstream tag already exists in our releases
        if echo "$EXISTING_RELEASES" | grep -q "^$UPSTREAM_TAG$"; then
          echo "new_version=false" >> $GITHUB_OUTPUT
          echo "Version $UPSTREAM_TAG already exists in this repo"
        else
          echo "new_version=true" >> $GITHUB_OUTPUT
          echo "New version detected: $UPSTREAM_TAG (not found in existing releases)"
        fi

    - name: Clone, build, and copy upstream
      if: steps.version-check.outputs.new_version == 'true'
      run: |
        # Clone upstream repo
        git clone https://github.com/ram02z/tree-sitter-fish.git upstream-repo
        cd upstream-repo
        
        # Checkout the latest tag
        git checkout ${{ steps.upstream-release.outputs.latest_tag }}
        
        # Install dependencies
        npm install
        
        # Build WASM
        npm run build:wasm
        
        # Copy WASM file to our repo
        cp tree-sitter-fish.wasm ../tree-sitter-fish.wasm
        echo "WASM build completed"

        cp -r queries ../queries
        echo "Copied queries files"

        cd ..
        echo "Upstream build and copy completed"

    - name: Install dependencies and build package
      if: steps.version-check.outputs.new_version == 'true'
      run: |
        yarn install --frozen-lockfile
        yarn build
        echo "Package build completed"
    - name: Update package version
      if: steps.version-check.outputs.new_version == 'true'
      run: |
        # Extract version number (remove 'v' prefix if present)
        VERSION=${{ steps.upstream-release.outputs.latest_tag }}
        VERSION=${VERSION#v}
        
        # Update package.json version
        yarn version --new-version $VERSION --no-git-tag-version
        
        echo "Updated package version to $VERSION"

    - name: Test package
      if: steps.version-check.outputs.new_version == 'true'
      run: |
        # Test that bundle files exist
        test -f dist/index.js || (echo "CommonJS bundle missing!" && exit 1)
        test -f dist/index.mjs || (echo "ESM bundle missing!" && exit 1)
        test -f dist/cli.mjs || (echo "CLI bundle missing!" && exit 1)
        
        # Test package structure
        yarn pack --dry-run
        
        # Create test package
        yarn pack
        
        # Basic module load test
        node -e "
          try {
            const pkg = require('./dist/index.js');
            console.log('Package exports:', Object.keys(pkg));
            console.log('Language name:', pkg.languageName);
            console.log('Version:', pkg.version);
            console.log('WASM embedded:', pkg.wasmPath.startsWith('embedded://'));
            console.log('Highlights embedded:', pkg.highlights.path.startsWith('embedded://'));
            console.log('Highlights content length:', pkg.highlights.text.length);
            pkg.getWasm().then(wasm => {
              console.log('WASM size:', wasm.byteLength, 'bytes');
              console.log('Package test: PASSED');
            }).catch(e => {
              console.error('WASM test failed:', e);
              process.exit(1);
            });
          } catch (e) {
            console.error('Package test: FAILED', e);
            process.exit(1);
          }
        "


    - name: Commit and push changes
      if: steps.version-check.outputs.new_version == 'true'
      run: |
        git config --local user.email "action@github.com"
        git config --local user.name "GitHub Action"
        git add .
        git commit -m "Auto-build: Update to ${{ steps.upstream-release.outputs.latest_tag }}"
        git push

    - name: Publish to NPM
      if: steps.version-check.outputs.new_version == 'true' && env.NPM_TOKEN != ''
      env:
        NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}
      run: |
        yarn publish --access public

    - name: Create GitHub Release
      if: steps.version-check.outputs.new_version == 'true'
      uses: actions/create-release@v1
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
      with:
        tag_name: ${{ steps.upstream-release.outputs.latest_tag }}
        release_name: Release ${{ steps.upstream-release.outputs.latest_tag }}
        body: |
          Auto-generated release for tree-sitter-fish ${{ steps.upstream-release.outputs.latest_tag }}
          
          This package contains the WebAssembly build of tree-sitter-fish grammar.
          
          Upstream release: https://github.com/ram02z/tree-sitter-fish/releases/tag/${{ steps.upstream-release.outputs.latest_tag }}
        draft: false
        prerelease: ${{ github.event_name == 'release' && github.event.release.prerelease }}

    - name: Upload package artifacts
      if: steps.version-check.outputs.new_version == 'true'
      uses: actions/upload-artifact@v4
      with:
        name: npm-package
        path: |
          *.tgz
          tree-sitter-fish.wasm
        retention-days: 30
