{
  "name": "@ndonfris/tree-sitter-fish",
  "version": "3.6.0-dev.1759542286889",
  "description": "Tree-sitter grammar for Fish shell with WebAssembly support",
  "bin": {
    "tree-sitter.fish.wasm": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tree-sitter-fish.wasm": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "tree-sitter",
    "fish",
    "shell",
    "parser",
    "wasm",
    "webassembly",
    "syntax",
    "highlighting"
  ],
  "author": "ndonfris",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ndonfris/tree-sitter-fish.wasm.git"
  },
  "homepage": "https://github.com/ndonfris/tree-sitter-fish.wasm",
  "bugs": {
    "url": "https://github.com/ndonfris/tree-sitter-fish.wasm/issues"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.6.2",
    "esbuild": "^0.25.10",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev": "node scripts/build.js",
    "build": "node scripts/build.js",
    "build:types": "tsc --emitDeclarationOnly --outDir dist/ --listEmittedFiles --inlineSourceMap false",
    "typecheck": "tsc --noEmit",
    "deps:build": "node scripts/build-deps.js",
    "deps:check": "node scripts/deps-check.js compare",
    "deps:check:upstream": "node scripts/deps-check.js upstream",
    "deps:check:local": "node scripts/deps-check.js local",
    "deps:check:current": "node scripts/deps-check.js current",
    "deps:update": "yarn deps:build latest && yarn set-version $(yarn -s deps:check:upstream) --update-last-version",
    "dev:pack": "node scripts/dev-install.js pack",
    "dev:install": "node scripts/dev-install.js install",
    "set-version": "node scripts/set-version.js",
    "clean": "rimraf dist node_modules *.tgz",
    "clean:packs": "rimraf *.tgz",
    "clean:packs:keep-latest": "ls -t *.tgz 2>/dev/null | tail -n +2 | xargs -r rm -f",
    "clean:only": "rimraf",
    "packs:latest": "ls -t *.tgz | head -n1",
    "test": "run-s typecheck build test:only",
    "test:only": "node scripts/test.js",
    "prepublishOnly": "yarn build && test -f dist/index.js || (echo 'Bundle missing!' && exit 1)"
  }
}
